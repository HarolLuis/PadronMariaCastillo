# =============================================================================
# Configuración Apache / LiteSpeed para Hostinger
# Sistema de Padrón Electoral - María Castillo
# =============================================================================

# 1. Página de inicio por defecto
DirectoryIndex index.php index.html

# 2. Bloquear descarga directa de archivos de base de datos y scripts sensibles
<FilesMatch "^(database\.sql|config\.php|\.env|\.git)">
    Require all denied
</FilesMatch>

# 3. Forzar codificación UTF-8
AddDefaultCharset UTF-8
AddCharset UTF-8 .html .css .js .json .php

# 4. Habilitar compresión Gzip para mayor velocidad
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json
</IfModule>

# 5. Seguridad: Deshabilitar listado de directorios
Options -Indexes
